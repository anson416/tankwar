{
  "name": "rl-tankwar",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "In-browser self-play reinforcement-learning tank arena (戰車大戰) — train a fleet of DQN agents live, watch them duel, or take the wheel yourself.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && node scripts/copy-tfjs-wasm.mjs && vite build",
    "build:check": "node scripts/check-build-artifacts.mjs",
    "build:verify": "npm run build && npm run build:check && npm run test:smoke",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "npx playwright test --config playwright.config.ts"
  },
  "dependencies": {
    "@tensorflow/tfjs-backend-cpu": "4.22.0",
    "@tensorflow/tfjs-backend-wasm": "4.22.0",
    "@tensorflow/tfjs-backend-webgl": "4.22.0",
    "@tensorflow/tfjs-backend-webgpu": "4.22.0",
    "@tensorflow/tfjs-core": "4.22.0",
    "@tensorflow/tfjs-layers": "4.22.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.20.1",
    "typescript": "^5.7.0",
    "vite": "^8.2.2",
    "vite-plugin-javascript-obfuscator": "^3.1.0",
    "vitest": "^4.1.11"
  }
}
